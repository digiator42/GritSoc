# GritSoc stack overrides. Copy to .env to customize; every value has a
# working default in docker-compose.yml, so .env is optional.

# Shared Postgres (used by Admin Command Center + GritJira)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin

# Optional API keys (empty = auth disabled for that service)
SOC_API_KEY=
LUX_API_KEY=
IRT_API_KEY=

# LuxShield simulator knobs
LUX_SIM_PPS=60
LUX_SPIKE_BPS=250000

# GritIRT alert correlation window (ms)
IRT_DEDUP_WINDOW_MS=300000

# GritJira auth
JWT_SECRET=change-me-in-production
GRITSHIELD_ADMIN_USER=admin
GRITSHIELD_ADMIN_PASSWORD=gritshield2026
